generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  EDITOR
  VIEWER
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(EDITOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  auditLogs    AuditLog[]
  revisions    PageRevision[]
  toolRevisions ToolRevision[]
  posts        BlogPost[]
  postRevisions PostRevision[]
  mediaAssets  MediaAsset[]

  @@map("admin_users")
}

model Page {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  status      PageStatus     @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  content     PageContent?
  seo         PageSeo?
  revisions   PageRevision[]

  @@map("pages")
}

model PageContent {
  id          String   @id @default(cuid())
  pageId      String   @unique
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  isPublished Boolean  @default(false)
  blocks      Json     @default("[]")
  customCss   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("page_contents")
}

model PageSeo {
  id                 String   @id @default(cuid())
  pageId             String   @unique
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  schemaType         String?
  schemaJson         Json?
  focusKeyword       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("page_seo")
}

model ToolContent {
  id              String   @id @default(cuid())
  toolSlug        String   @unique
  customTitle     String?
  customH1        String?
  customDescription String?
  customIntro     String?
  customValueProp String?
  customHowTo     Json?
  customFeatures  Json?
  customFaq       Json?
  customRelatedTools Json?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seo             ToolSeo?
  revisions       ToolRevision[]

  @@map("tool_contents")
}

model ToolSeo {
  id                 String      @id @default(cuid())
  toolContentId      String      @unique
  toolContent        ToolContent @relation(fields: [toolContentId], references: [id], onDelete: Cascade)
  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?
  robotsIndex        Boolean     @default(true)
  robotsFollow       Boolean     @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  schemaType         String?
  schemaJson         Json?
  focusKeyword       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("tool_seo")
}

model ToolRevision {
  id              String      @id @default(cuid())
  toolContentId   String
  toolSlug        String
  toolContent     ToolContent @relation(fields: [toolContentId], references: [id], onDelete: Cascade)
  contentSnapshot Json
  seoSnapshot     Json?
  authorId        String?
  author          AdminUser?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reason          String?
  createdAt       DateTime    @default(now())

  @@index([toolSlug])
  @@map("tool_revisions")
}

model PageRevision {
  id              String     @id @default(cuid())
  pageId          String
  page            Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contentSnapshot Json
  seoSnapshot     Json?
  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reason          String?
  createdAt       DateTime   @default(now())

  @@map("page_revisions")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model GlobalSettings {
  id                     String   @id @default("default")
  siteName               String   @default("Free Online File Tools")
  siteUrl                String   @default("https://example.com")
  defaultSeoTitle        String?
  defaultMetaDescription String?
  defaultOgImage         String?
  defaultTwitterImage    String?
  googleAnalyticsId      String?
  googleAdSenseId        String?
  socialLinks            Json?
  updatedAt              DateTime @updatedAt

  @@map("global_settings")
}

model BlogPost {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  excerpt          String?
  content          String         @default("")
  featuredImage    String?
  featuredImageAlt String?
  readingTime      String?
  status           PostStatus     @default(DRAFT)
  publishedAt      DateTime?
  scheduledFor     DateTime?

  authorId         String?
  author           AdminUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId       String?
  category         BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags             PostTag[]
  seo              PostSeo?
  revisions        PostRevision[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledFor])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  posts       BlogPost[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_categories")
}

model BlogTag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  posts     PostTag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("blog_tags")
}

model PostTag {
  postId String
  tagId  String

  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model PostSeo {
  id                 String   @id @default(cuid())
  postId             String   @unique
  post               BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?

  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)

  ogTitle            String?
  ogDescription      String?
  ogImage            String?

  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  schemaType         String?  @default("Article")
  schemaJson         Json?
  focusKeyword       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("post_seo")
}

model PostRevision {
  id              String     @id @default(cuid())
  postId          String
  post            BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  contentSnapshot Json
  seoSnapshot     Json?

  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  reason          String?
  createdAt       DateTime   @default(now())

  @@index([postId])
  @@index([createdAt])
  @@map("post_revisions")
}

model MediaAsset {
  id               String     @id @default(cuid())
  filename         String     @unique
  originalFilename String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  url              String
  storagePath      String
  alt              String?
  title            String?
  caption          String?
  description      String?

  uploadedById     String?
  uploadedBy       AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([mimeType])
  @@index([createdAt])
  @@index([uploadedById])
  @@map("media_assets")
}
